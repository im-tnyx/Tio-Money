{
  "name": "tio-money",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"app.json\" \"package.json\" \"tsconfig.json\" \"eslint.config.js\" \".prettierrc.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"app.json\" \"package.json\" \"tsconfig.json\" \"eslint.config.js\" \".prettierrc.json\"",
    "test": "tsx --test tests/**/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "expo:config": "expo config --type public",
    "expo:doctor": "npx expo-doctor",
    "expo:deps": "expo install --check"
  },
  "dependencies": {
    "expo": "~58.0.24",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.13",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.38.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
}
